---
import ContactForm from '../components/ContactForm.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <h1 class="text-4xl font-bold p-2">
        Make A Booking
    </h1>

    <div class="flex flex-col-2 items-center gap-8">
        <div class="w-full">
            <ContactForm />
        </div>
        <div class="w-full">
            <img src="/src/assets/owt-4.jpg" alt="Photo of Oakwards Travel coach" class="rounded-lg">
        </div>
    </div>

</Layout>
