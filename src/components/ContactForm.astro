<form class="bg-white p-6 rounded-lg shadow-md">
    <label for="name" class="block text-gray-700 font-bold">Name</label>
    <input type="text" id="name" class="w-1/3 border p-2 rounded-lg mt-1" placeholder="John Doe" required>

    <label for="number" class="block text-gray-700 font-bold">Contact Number</label>
    <input type="number" id="number" class="w-1/3 border p-2 rounded-lg mt-1" placeholder="0151 123 4567" required>
    
    <label for="email" class="block text-gray-700 font-bold mt-4">Email</label>
    <input type="email" id="email" class="w-1/3 border p-2 rounded-lg mt-1" placeholder="email@example.com" required>

    <label for="reason" class="block text-gray-700 font-bold mt-4">Reason For Contact</label>
    <select id="reason" class="border p-2 rounded-lg mt-1">
        <option value=""></option>
        <option value="general">General Enquiry</option>
        <option value="booking">Make A Booking</option>
        <option value="other">Other</option>
    </select>
  
    <label for="message" class="block text-gray-700 font-bold mt-4">Message</label>
    <textarea class="w-1/3 border p-2 rounded-lg mt-1" id="message" placeholder="Any additonal information" required></textarea>
  
    <button type="submit" class="block bg-green-600 text-white px-4 py-2 rounded-lg mt-4">Send</button>
  </form>