---
import HamburgerMenu from './HamburgerMenu'

const links = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Services", href: "/services" },
  { name: "Contact", href: "/contact" }
];
---
<nav class="bg-green-600 text-white py-4">
    <div class="container mx-auto flex justify-center items-center space-x-9">
      <!-- Left Links -->
      <ul class="hidden md:flex space-x-6 text-2xl">
        {links.slice(0, 2).map(link => (
          <li><a href={link.href} class="hover:underline">{link.name}</a></li>
        ))}
      </ul>
  
      <!-- Logo Centered -->
      <a href="/" class="flex items-center">
        <img src="/src/assets/oakwards-travel-logo.svg" alt="Oakwards Travel" class="h-60">
      </a>
  
      <!-- Right Links -->
      <ul class="hidden md:flex space-x-6 text-2xl">
        {links.slice(2).map(link => (
          <li><a href={link.href} class="hover:underline">{link.name}</a></li>
        ))}
      </ul>
    </div>
  
    
  </nav>